# Required on Railway. Never commit the real token.
DISCORD_BOT_TOKEN=put_your_discord_bot_token_in_railway

# Optional stable channel configuration. Discord channel IDs are numbers.
# If these are empty, use /set-scan-channel and /set-report-channel.
SCAN_CHANNEL_ID=
REPORT_CHANNEL_ID=

# Optional safety/configuration settings.
MAX_FILE_BYTES=2097152
CONFIG_PATH=data/config.json
LOG_LEVEL=INFO